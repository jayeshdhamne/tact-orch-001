# ==============================================================================
# TACT-ORCH-001 — Environment Variables Template
# Copy this file to .env and configure local secrets:
#   cp .env.example .env
# NEVER commit the filled .env file to Git!
# ==============================================================================

# ─── 1. PostgreSQL (Backend for Windmill) ────────────────────────────────────
# Strong random password for the internal Windmill database
POSTGRES_PASSWORD=your_secure_postgres_password_here

# ─── 2. LiveKit Cloud (WebRTC Signaling & Token Generation) ──────────────────
# Obtain from https://cloud.livekit.io -> Project Settings -> Keys
LIVEKIT_URL=https://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ─── 3. n8n (Marketing Workflow Engine — Local Container) ─────────────────────
# Internal Docker network endpoint for the containerized n8n service
N8N_WEBHOOK_URL=http://n8n:5678/webhook/safi-gate
# Shared secret for X-Gate-Secret header authentication
N8N_WEBHOOK_SECRET=your_custom_shared_webhook_secret_here

# ─── 4. Calnode (Go + SQLite Micro-Scheduler) ────────────────────────────────
# API key used to authenticate with Calnode's /v1 endpoints
CALNODE_API_KEY=your_calnode_api_key_here

# ─── 5. Windmill (Operations Task Engine) ────────────────────────────────────
# Generated from Windmill UI (http://127.0.0.1:8000) under Workspace Settings -> Tokens
WINDMILL_TOKEN=your_windmill_api_token_here
WINDMILL_WORKSPACE=safi

# ─── 6. Conversation / Room Identifiers ──────────────────────────────────────
CONV_A_ENQUIRY=conv-customer-a-enquiry
CONV_B_PRICING=conv-customer-b-pricing
CONV_A_DEMO=conv-customer-a-demo
